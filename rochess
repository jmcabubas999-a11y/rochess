ui.autoPlayKeybind = VortexSection:Keybind({
    Title = "auto move keybind",
    Desc = "keybind 4 automove",
    Value = Enum.KeyCode.J,
    Callback = function()
        local newValue = not state.autoPlay
        -- :Set first in its own pcall so the toggle visually flips AND fires its
        -- callback (which calls setAutoPlay). Separate pcall from :SetValue so
        -- if one method is missing on this WindUI fork the other still runs.
        pcall(function() ui.autoPlayToggle:Set(newValue) end)
        pcall(function() ui.autoPlayToggle:SetValue(newValue) end)
        -- if :Set didn't fire the callback (or errored), state.autoPlay is still
